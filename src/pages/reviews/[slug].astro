---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const reviewModules = import.meta.glob('../../content/reviews/*.md', { eager: true });

  return Object.entries(reviewModules).map(([filepath, mod]: [string, any]) => ({
    params: { slug: filepath.split('/').pop().replace('.md', '') },
    props: { frontmatter: mod.frontmatter, Content: mod.Content },
  }));
}

const { frontmatter, Content } = Astro.props;
const { title, description, priceRange, rating, category, date, bolUrl, amazonUrl, image } = frontmatter;

const stars = '★'.repeat(Math.round(rating)) + '☆'.repeat(5 - Math.round(rating));
const formattedDate = new Date(date).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Layout title={title} description={description}>
  <div class="mb-8">
    <a href="/" class="text-sm text-gray-400 hover:text-gray-600 transition-colors mb-6 inline-flex items-center gap-1">
      ← Alle reviews
    </a>

    {image && (
      <div class="mt-4 mb-6 rounded-2xl overflow-hidden h-64 bg-gray-100">
        <img
          src={image}
          alt={title}
          class="w-full h-full object-cover"
        />
      </div>
    )}

    <div class="flex items-center gap-2 mt-4 mb-3">
      <span class="text-xs font-medium bg-gray-100 text-gray-500 px-2 py-1 rounded-full">{category}</span>
      <span class="text-xs text-gray-400">{formattedDate}</span>
    </div>

    <h1 class="text-3xl font-bold text-gray-900 mb-2 leading-tight">{title}</h1>
    <p class="text-gray-500 text-lg">{description}</p>

    <div class="flex flex-wrap items-center gap-4 mt-5 p-4 bg-gray-50 rounded-xl">
      <div>
        <div class="text-yellow-400 text-lg">{stars}</div>
        <div class="text-xs text-gray-400">{rating}/5</div>
      </div>
      <div class="border-l border-gray-200 pl-4">
        <div class="font-semibold text-gray-900">{priceRange}</div>
        <div class="text-xs text-gray-400">prijsrange</div>
      </div>
      <div class="ml-auto flex flex-wrap gap-2">
        {bolUrl && (
          <a
            href={bolUrl}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="bg-brand-600 hover:bg-brand-700 text-white font-medium px-4 py-2 rounded-xl text-sm transition-colors inline-block"
          >
            Bekijk op Bol.com →
          </a>
        )}
        {amazonUrl && (
          <a
            href={amazonUrl}
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="bg-orange-500 hover:bg-orange-600 text-white font-medium px-4 py-2 rounded-xl text-sm transition-colors inline-block"
          >
            Bekijk op Amazon →
          </a>
        )}
      </div>
    </div>
  </div>

  <article class="review-content">
    <Content />
  </article>

  <div class="mt-12 p-6 bg-gray-50 border border-gray-100 rounded-2xl">
    <p class="text-gray-700 mb-4 font-medium text-center">Interesse? Vergelijk de prijs:</p>
    <div class="flex flex-wrap justify-center gap-3">
      {bolUrl && (
        <a
          href={bolUrl}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="bg-brand-600 hover:bg-brand-700 text-white font-semibold px-6 py-3 rounded-xl text-sm transition-colors inline-block"
        >
          Bekijk op Bol.com
        </a>
      )}
      {amazonUrl && (
        <a
          href={amazonUrl}
          target="_blank"
          rel="noopener noreferrer nofollow"
          class="bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-xl text-sm transition-colors inline-block"
        >
          Bekijk op Amazon.nl
        </a>
      )}
    </div>
    <p class="text-xs text-gray-400 mt-3 text-center">Bol.com link is een affiliate link, kost jou niets extra.</p>
  </div>
</Layout>
